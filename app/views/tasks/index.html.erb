<p id="notice"><%= notice %></p>

<h1>Tasks</h1>

<%= search_form_for @q do |f| %>
  <div>
    <%= f.label :title_or_description_cont, 'キーワード' %><br>
    <%= f.search_field :title_or_description_cont %>
  </div>

  <div>
    <%= f.label :deadline_gteq, '期間' %><br>
    <%= f.date_field :deadline_gteq %>
    ～
    <%= f.date_field :deadline_lteq %>
  </div>

  <div>
    <span>ステータス</span><br>

    <%= f.radio_button :status_eq, '',
          id: 'q_status_eq_blank',
          checked: params.dig(:q, :status_eq).blank? %>
    <%= label_tag 'q_status_eq_blank', '指定なし' %>

    <% Task.statuses.each do |status_name, status_value| %>
      <%= f.radio_button :status_eq,
            status_value,
            id: "q_status_eq_#{status_name}" %>
      <%= label_tag "q_status_eq_#{status_name}", status_name %>
    <% end %>
  </div>

  <div>
    <%= f.submit 'Search' %>
  </div>
<% end %>

<br>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Description</th>
      <th>Status</th>
      <th>
        <%= sort_link(@q, :deadline, 'Deadline', default_order: :desc) %>
      </th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.description %></td>
        <td><%= task.status %></td>
        <td><%= task.deadline.strftime("%Y-%m-%d %H:%M") %></td>
        <td><%= link_to 'Show', task %></td>
        <td><%= link_to 'Edit', edit_task_path(task) %></td>
        <td><%= link_to 'Destroy', task, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Task', new_task_path %>